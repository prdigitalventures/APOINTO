# Local / hosted Postgres (Neon, Railway Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Direct (non-pooled) connection — required for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
JWT_SECRET="change-this-in-production"
# Comma-separated emails that get Super admin on the ops dashboard (/admin)
ADMIN_EMAILS=""
# Owner AI Business Builder. Prefer Gemini; the wizard still works without any key.
GEMINI_API_KEY=""
# Optional aliases: GOOGLE_AI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Public site URL used in verification / reset emails
APP_URL="https://www.apointo.online"

# Google OAuth — Web application client.
# In Google Cloud Console → APIs & Services → Credentials → your OAuth client,
# Authorized JavaScript origins MUST include:
#   https://www.apointo.online
#   https://apointo.online
#   http://localhost:3000
# Authorized redirect URIs MUST include (no trailing slash):
#   https://www.apointo.online/api/auth/google/callback
#   https://apointo.online/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# Production always sends the www callback above. A missing URI causes
# Google Error 400: redirect_uri_mismatch.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://www.apointo.online/api/auth/google/callback"

# Email delivery — verification, credentials, shop-ready, campaigns, password reset.
# Prefer Resend with a verified domain (apointo.online). SMTP is used if Resend is not set.
# If neither is configured, tokens are still created and the full URL is written to server logs.
RESEND_API_KEY=""
EMAIL_FROM="Apointo <noreply@apointo.online>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM=""
