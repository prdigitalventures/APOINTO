generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  role      String   @default("CUSTOMER")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses         Business[]
  bookings           Booking[]           @relation("CustomerBookings")
  notifications      Notification[]
  onboardingSessions OnboardingSession[]
}

model Business {
  id                 String   @id @default(cuid())
  ownerId            String
  name               String
  slug               String   @unique
  category           String
  description        String?
  location           String?
  timezone           String   @default("Asia/Kolkata")
  logo               String?
  about              String?
  bookingSchema      String?
  bookingRules       String?
  advanceBookingDays Int      @default(30)
  cancellationHours  Int      @default(2)
  bufferMinutes      Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerUser     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services      Service[]
  staff         Staff[]
  businessHours BusinessHour[]
  breaks        Break[]
  holidays      Holiday[]
  blockedSlots  BlockedSlot[]
  bookings      Booking[]
}

model Service {
  id           String  @id @default(cuid())
  businessId   String
  name         String
  description  String?
  price        Float   @default(0)
  duration     Int
  bufferBefore Int     @default(0)
  bufferAfter  Int     @default(0)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)
  metadata     String?

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  bookings      Booking[]
}

model Staff {
  id         String  @id @default(cuid())
  businessId String
  name       String
  role       String?
  isActive   Boolean @default(true)
  metadata   String?

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  staffHours    StaffHour[]
  bookings      Booking[]
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model BusinessHour {
  id          String  @id @default(cuid())
  businessId  String
  day         Int
  openingTime String
  closingTime String
  isClosed    Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

model StaffHour {
  id          String  @id @default(cuid())
  staffId     String
  day         Int
  openingTime String
  closingTime String
  isClosed    Boolean @default(false)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day])
}

model Break {
  id         String  @id @default(cuid())
  businessId String
  day        Int?
  startTime  String
  endTime    String
  label      String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Holiday {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime
  label      String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BlockedSlot {
  id         String   @id @default(cuid())
  businessId String
  staffId    String?
  date       DateTime
  startTime  String
  endTime    String
  reason     String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String   @id @default(cuid())
  businessId      String
  customerId      String?
  serviceId       String
  staffId         String?
  customerName    String
  customerPhone   String
  date            DateTime
  startTime       String
  endTime         String
  status          String   @default("PENDING")
  isWalkIn        Boolean  @default(false)
  rejectionReason String?
  customData      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        User?            @relation("CustomerBookings", fields: [customerId], references: [id])
  service         Service          @relation(fields: [serviceId], references: [id])
  staff           Staff?           @relation(fields: [staffId], references: [id])
  bookingRequests BookingRequest[]
  timeRequests    TimeRequest[]
}

model BookingRequest {
  id            String   @id @default(cuid())
  bookingId     String
  requestedBy   String
  requestedDate DateTime?
  requestedTime String?
  status        String   @default("PENDING")
  message       String?
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model TimeRequest {
  id                String   @id @default(cuid())
  bookingId         String
  requestedBy       String
  additionalMinutes Int
  status            String   @default("PENDING")
  newStartTime      String?
  createdAt         DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingSession {
  id        String   @id @default(cuid())
  userId    String
  state     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
